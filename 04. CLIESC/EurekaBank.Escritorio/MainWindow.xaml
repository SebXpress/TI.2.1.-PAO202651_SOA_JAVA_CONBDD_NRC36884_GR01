<Window x:Class="EurekaBank.Escritorio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EurekaBank - Cliente de Escritorio" Height="620" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid><TextBlock Text="EurekaBank Escritorio" FontSize="22" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,15"/><Button x:Name="BtnLogout" Content="Cerrar sesión" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Click="BtnLogout_Click" Foreground="#DC3545" Background="Transparent" BorderThickness="0"/></Grid>
        <StackPanel x:Name="LoginPanel" Grid.Row="1" Margin="20" HorizontalAlignment="Center" Width="300">
            <Image Source="imagen-front.jpg" Height="190" Stretch="Uniform" Margin="0,0,0,12"/>
            <TextBlock Text="Iniciar sesión" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBox x:Name="TxtUsuario" Height="30" Margin="0,0,0,8" ToolTip="Usuario"/>
            <PasswordBox x:Name="TxtClave" Height="30" Margin="0,0,0,12"/>
            <Button Content="Ingresar" Height="35" Click="BtnLogin_Click" Background="#0D6EFD" Foreground="White"/>
        </StackPanel>

        <!-- Banner de Mensajes -->
        <Border x:Name="BorderMensaje" Grid.Row="2" VerticalAlignment="Top" Background="#E2E3E5" Padding="10" Margin="0,0,0,15" Visibility="Collapsed" CornerRadius="5">
            <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <!-- Panel de Operaciones -->
        <TabControl x:Name="OperationsPanel" Grid.Row="3" Visibility="Collapsed">
            <!-- Tab 1: Consulta de Saldo -->
            <TabItem Header="Consultar Saldo">
                <StackPanel Margin="15">
                    <TextBlock Text="Número de cuenta (8 dígitos):" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox x:Name="CmbCuentaSaldo" Margin="0,0,0,15" Height="30" MaxLength="8" VerticalContentAlignment="Center"/>
                    <Button Content="Consultar Saldo" Height="35" Background="#0D6EFD" Foreground="White" FontWeight="Bold" Click="BtnConsultarSaldo_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Depósito -->
            <TabItem Header="Registrar Depósito">
                <StackPanel Margin="15">
                    <TextBlock Text="Cuenta Destino:" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox x:Name="CmbCuentaDeposito" Margin="0,0,0,10" Height="30" MaxLength="8" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Monto ($):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtMontoDeposito" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Código de empleado (4 dígitos):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEmpleadoDeposito" Height="30" MaxLength="4" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                    <Button Content="Realizar Depósito" Height="35" Background="#198754" Foreground="White" FontWeight="Bold" Click="BtnDeposito_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 3: Retiro -->
            <TabItem Header="Registrar Retiro">
                <StackPanel Margin="15">
                    <TextBlock Text="Cuenta Origen:" Margin="0,0,0,5" FontWeight="Bold"/>
                    <TextBox x:Name="CmbCuentaRetiro" Margin="0,0,0,10" Height="30" MaxLength="8" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Monto ($):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtMontoRetiro" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Código de empleado (4 dígitos):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEmpleadoRetiro" Height="30" MaxLength="4" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                    <Button Content="Realizar Retiro" Height="35" Background="#FFC107" Foreground="Black" FontWeight="Bold" Click="BtnRetiro_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Registrar Transferencia">
                <StackPanel Margin="15">
                    <TextBlock Text="Cuenta Origen:" FontWeight="Bold"/><TextBox x:Name="CmbCuentaOrigen" Height="30" MaxLength="8" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Cuenta Destino:" FontWeight="Bold"/><TextBox x:Name="CmbCuentaDestino" Height="30" MaxLength="8" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Monto ($)"/><TextBox x:Name="TxtMontoTransferencia" Height="30" Margin="0,0,0,15"/>
                    <TextBlock Text="Código de empleado (4 dígitos):" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtEmpleadoTransferencia" Height="30" MaxLength="4" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                    <Button Content="Realizar Transferencia" Height="35" Background="#0dcaf0" Foreground="White" FontWeight="Bold" Click="BtnTransferencia_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
